{
  "name": "@xixizi-kiara/dsh-godot-docs-rag",
  "version": "0.1.1",
  "description": "在 DSH 中提供 Godot 官方文档检索、API 符号直达与整页读取（本地 RAG）",
  "license": "MIT",
  "author": "XiXizi-Kiara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiXizi-Kiara/dsh-godot-docs-rag.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/XiXizi-Kiara/dsh-godot-docs-rag#readme",
  "bugs": {
    "url": "https://github.com/XiXizi-Kiara/dsh-godot-docs-rag/issues"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "godot",
    "rag",
    "documentation"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./usage-log": "./usage-log/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./usage-log/locale/*.json": "./usage-log/locale/*.json",
    "./usage-log/icon": "./usage-log/icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "usage-log/index.js",
    "usage-log/locale/*.json",
    "usage-log/icon.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
